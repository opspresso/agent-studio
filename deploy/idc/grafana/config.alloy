remotecfg {
  url            = "https://fleet-management-prod-001.grafana.net"
  id             = sys.env("GCLOUD_FM_COLLECTOR_ID")
  poll_frequency = "60s"

  basic_auth {
    username = "112402"
    password = sys.env("GCLOUD_RW_API_KEY")
  }
}

prometheus.remote_write "metrics_service" {
  endpoint {
    url = "https://prometheus-us-central1.grafana.net/api/prom/push"

    basic_auth {
      username = "2124611"
      password = sys.env("GCLOUD_RW_API_KEY")
    }
  }
}

prometheus.scrape "agent_studio" {
  targets = [{
    "__address__" = "studio.opspresso.com:443",
    "instance"    = sys.env("GCLOUD_FM_COLLECTOR_ID"),
  }]

  scheme          = "https"
  metrics_path    = "/api/metrics"
  scrape_interval = "30s"
  scrape_timeout  = "10s"
  job_name        = "agent-studio"

  forward_to = [prometheus.remote_write.metrics_service.receiver]
}

prometheus.scrape "agent_memory" {
  targets = [{
    "__address__" = "memory.opspresso.com:443",
    "instance"    = sys.env("GCLOUD_FM_COLLECTOR_ID"),
  }]

  scheme          = "https"
  metrics_path    = "/api/metrics"
  scrape_interval = "30s"
  scrape_timeout  = "10s"
  job_name        = "agent-memory"

  forward_to = [prometheus.remote_write.metrics_service.receiver]
}

prometheus.exporter.unix "integrations_node_exporter" {
  disable_collectors = ["ipvs", "btrfs", "infiniband", "xfs", "zfs"]

  filesystem {
    fs_types_exclude     = "autofs|binfmt_misc|bpf|cgroup2?|configfs|debugfs|devpts|devtmpfs|fusectl|hugetlbfs|iso9660|mqueue|nsfs|overlay|proc|procfs|pstore|rpc_pipefs|securityfs|selinuxfs|squashfs|sysfs|tracefs"
    mount_points_exclude = "/dev|/proc|/run/credentials/.+|/sys|/var/lib/docker/.+|/var/lib/containers/storage/.+"
    mount_timeout        = "5s"
  }
}

discovery.relabel "integrations_node_exporter" {
  targets = prometheus.exporter.unix.integrations_node_exporter.targets

  rule {
    target_label = "instance"
    replacement  = sys.env("GCLOUD_FM_COLLECTOR_ID")
  }

  rule {
    target_label = "job"
    replacement  = "integrations/node_exporter"
  }
}

prometheus.scrape "integrations_node_exporter" {
  targets    = discovery.relabel.integrations_node_exporter.output
  forward_to = [prometheus.relabel.integrations_node_exporter.receiver]

  scrape_interval = "15s"
}

prometheus.relabel "integrations_node_exporter" {
  forward_to = [prometheus.remote_write.metrics_service.receiver]

  rule {
    source_labels = ["__name__"]
    regex         = "node_scrape_collector_.+"
    action        = "drop"
  }
}

prometheus.exporter.cadvisor "integrations_cadvisor" {
  docker_host = "unix:///var/run/docker.sock"
  docker_only = true

  disable_root_cgroup_stats = true
  store_container_labels    = false
  allowlisted_container_labels = [
    "com.docker.compose.project",
    "com.docker.compose.service",
  ]
  enabled_metrics  = ["cpu", "memory", "network", "diskIO", "oom_event"]
  storage_duration = "2m"
}

discovery.relabel "integrations_cadvisor" {
  targets = prometheus.exporter.cadvisor.integrations_cadvisor.targets

  rule {
    target_label = "instance"
    replacement  = sys.env("GCLOUD_FM_COLLECTOR_ID")
  }
}

prometheus.scrape "integrations_cadvisor" {
  targets    = discovery.relabel.integrations_cadvisor.output
  forward_to = [prometheus.relabel.integrations_cadvisor.receiver]

  scrape_interval = "30s"
  job_name        = "integrations/cadvisor"
}

prometheus.relabel "integrations_cadvisor" {
  forward_to = [prometheus.remote_write.metrics_service.receiver]

  rule {
    source_labels = ["container_label_com_docker_compose_project"]
    regex         = "agent-studio"
    action        = "keep"
  }

  rule {
    source_labels = ["container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    regex  = "container_label_com_docker_compose_(project|service)|id|image|name"
    action = "labeldrop"
  }
}
