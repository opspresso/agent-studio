# The secrets `scripts/deploy.sh` appends to `.env` and `.env.mcp`. Copy to
# `.env.secrets`, chmod 600, fill in what this host uses and delete the rest —
# a name left empty is left unset. A host with `.env.aws` and no
# `.env.secrets` reads the same names from SSM instead.
#
# Minting: `openssl rand -base64 32` for AES_ENCRYPTION_KEY (exactly 32 bytes),
# `openssl rand -hex 32` for the tokens.

# --- The app (required) --------------------------------------------------
# Decrypts every credential stored in the database. Losing it loses them;
# changing it does not fail at boot — it fails at every stored secret.
AES_ENCRYPTION_KEY=
# Signs session cookies.
BETTER_AUTH_SECRET=
# The default LLM channel's key (LLM_BASE_URL in .env.example).
LLM_API_KEY=

# --- Sign-in (one of) ----------------------------------------------------
# Password for BOOTSTRAP_ADMIN_EMAIL, created on first boot when AUTH_PASSWORD
# is true and nobody by that email exists.
BOOTSTRAP_ADMIN_PASSWORD=
# The OIDC client registered at OIDC_ISSUER.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Google, where a deployment uses it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional --------------------------------------------------------------
# Per-provider channels (LLM_PROVIDER_<NAME>_BASE_URL in .env.example).
LLM_PROVIDER_OPENAI_API_KEY=
LLM_PROVIDER_ANTHROPIC_API_KEY=
LLM_PROVIDER_GOOGLE_API_KEY=
LLM_PROVIDER_XAI_API_KEY=
LLM_PROVIDER_OPENROUTER_API_KEY=
# Inbound A2A; unset disables the A2A endpoints.
A2A_API_KEY=
# Plugins sync from GitHub (PLUGINS_REPO); unset means archive uploads only.
GITHUB_TOKEN=
# The ticker's token. Unset means nothing ticks: no schedules, no sweep.
SCHEDULE_SCAN_TOKEN=

# --- MCP servers ----------------------------------------------------------
BRAVE_API_KEY=
ARGOCD_API_TOKEN=
