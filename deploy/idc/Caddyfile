# TLS and the only thing this host exposes.
#
# Caddy proxies with no read timeout of its own, which is what a run needs: the
# deadline that ends a run is MAX_RUN_DURATION_MS inside the app, not a hop in
# front of it. The ALB this replaces had to have its idle_timeout raised to 600
# for exactly that reason — an image generation sends nothing for a minute and
# was being cut at 60 seconds.
{
	# ACME registration address. Let's Encrypt sends expiry warnings here.
	email me@nalbam.com
}

studio.opspresso.com {
	# Compression, listed rather than excluded: `encode`'s response matcher has
	# no `not`, so the way to keep text/event-stream out is to not name it. An
	# SSE response is one response that never ends, and compressing it puts a
	# buffer in front of exactly the bytes a reader is waiting for.
	encode {
		zstd
		gzip
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/plain*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type image/svg+xml*
		}
	}

	reverse_proxy app:3000 {
		# Forward each write as it arrives rather than on a timer. -1 is
		# unconditional; Caddy's default already does this for SSE responses it
		# recognises, and this makes it not depend on that recognition.
		flush_interval -1

		# The health check, and it asks the only question worth asking of a
		# **single** upstream: is the process serving at all.
		#
		# It used to ask /api/ready, which answers 503 while the instance drains
		# — right on a load balancer with somewhere else to send traffic, wrong
		# here. There is nowhere else. A plugins sync that reindexed the whole
		# catalog kept /api/ready from answering inside the timeout, Caddy marked
		# the only backend down, and every request for the next few seconds got a
		# 503 from Caddy instead of waiting for an app that was working fine.
		#
		# /api/health is dependency-free and static, so it fails only when the
		# process really cannot serve — and when the container is gone, the dial
		# fails and Caddy answers 503 anyway, which is the drain case handling
		# itself.
		health_uri /api/health
		health_interval 15s
		health_timeout 10s
	}
}
