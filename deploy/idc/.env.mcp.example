# Copy to `.env.mcp`. Addresses and accounts that belong to individual MCP
# servers — the parts a person types. The token half comes from SSM into
# `.env.mcp.secrets` (BRAVE_API_KEY, ARGOCD_API_TOKEN), which compose lists
# after this file.
#
# Everything below belongs to the `eks` profile. These three servers reached
# their targets over cluster DNS; from this host each needs an address that
# resolves publicly, and until one exists `docker compose --profile eks up -d`
# has nothing to point them at.

# mcp-argocd
ARGOCD_BASE_URL=

# mcp-grafana — basic auth with the same credentials that seed Grafana's own
# admin user (/k8s/common/admin-user, /k8s/common/admin-password), not a service
# account token: a token lives in Grafana's database and dies with the PVC.
GRAFANA_URL=
GRAFANA_USERNAME=
GRAFANA_PASSWORD=
