# The source of `.env`, which `scripts/deploy.sh` generates: this file with the
# image tags replaced by what argocd-env-demo says alpha runs, and the secrets
# from SSM appended. Change a setting here and rerun the script — never in
# `.env`, which the next run overwrites.
#
# Compose reads `.env` twice: once to substitute the ${…} in compose.yaml
# (image tags, the registry, the profiles), and once as the app's env_file.
# Only `.env` is read for substitution — a variable compose.yaml names has to
# live here, not in .env.aws or .env.mcp.example.

# --- Compose --------------------------------------------------------------
# The ticker is on: since the cluster stopped ticking alpha this is the only
# thing that fires its schedules, syncs its plugins and reindexes its catalog.
COMPOSE_PROFILES=ticker

# --- Image tags -----------------------------------------------------------
# Placeholders. deploy.sh writes the versions argocd-env-demo pins for alpha
# (each chart's versions-alpha.json), so this host runs what the cluster runs;
# a value here is only what a run that could not reach GitHub falls back to.
ECR_REGISTRY=396608815058.dkr.ecr.ap-northeast-2.amazonaws.com
AGENTDURE_TAG=v0.74.0
MCP_MEMORY_TAG=v0.7.0
MCP_DOCUMENT_TAG=v0.9.0
MCP_YOUTUBE_TAG=v0.4.0
MCP_BRAVE_TAG=v2.1.0
MCP_CLOUDWATCH_TAG=0.1.8
MCP_ARGOCD_TAG=v0.8.0
MCP_GRAFANA_TAG=1.0.0
MCP_KUBERNETES_TAG=v0.0.66

# --- Core -----------------------------------------------------------------
# alpha and prod are the same check; only `local` skips it. Both require
# ADMIN_EMAILS. An empty ALLOWED_EMAIL_DOMAINS is an unrestricted sign-in policy.
STAGE=alpha
ADMIN_EMAILS=me@nalbam.com
# Empty means any Google account may sign in. A stored /settings override may
# narrow it at runtime.
# ALLOWED_EMAIL_DOMAINS=nalbam.com
AWS_REGION=ap-northeast-2

# Outward-facing URL. A2A Agent Cards, Slack manifests, OAuth callbacks and the
# MCP client-metadata document are built from it, and behind a proxy it cannot
# be inferred from the request. alpha.agentdure.com remains a Caddy alias so
# webhooks registered before the domain change keep reaching this instance.
BETTER_AUTH_URL=https://agentdure.com
PUBLIC_BASE_URL=https://agentdure.com

# The compose network, so Better Auth can strip Caddy's hop off X-Forwarded-For
# and rate-limit per client IP rather than putting every request in one bucket.
TRUSTED_PROXY_CIDRS=172.31.240.0/24

# --- Storage --------------------------------------------------------------
# alpha's own set. The cluster is prod and reads the `agentdure-*` names, so a
# project made here is invisible there — see docs/OPERATIONS.md for what the two
# environments do and do not share. All of these are managed by
# terraform-env-demo/demo/9-agentdure.
DYNAMODB_TABLE_NAME=agent-studio
S3_BUCKET_NAME=agent-studio-static
VECTOR_BUCKET=agent-studio-vector
CATALOG_INDEX=capabilities
# Never set DYNAMODB_ENDPOINT here. It is DynamoDB Local's, and a leftover value
# points the app at a localhost that is not there.

# --- Capability catalog ---------------------------------------------------
# Cohere, and the floor belongs to it: a Korean query against an English
# description scores 0.39 here where Titan scores 0.065 — indistinguishable from
# noise. Re-measure CATALOG_MIN_SCORE if EMBEDDING_MODEL changes.
EMBEDDING_PROVIDER=cohere
EMBEDDING_MODEL=global.cohere.embed-v4:0
EMBEDDING_DIM=1024
CATALOG_MIN_SCORE=0.25

# --- LLM channels ---------------------------------------------------------
LLM_BASE_URL=https://api.openai.com/v1
UNKNOWN_MODEL_POLICY=allow
LLM_PROVIDER_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
LLM_PROVIDER_OPENAI_BASE_URL=https://api.openai.com/v1
LLM_PROVIDER_XAI_BASE_URL=https://api.x.ai/v1
LLM_PROVIDER_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Signed with the process's AWS credentials — the same access key .env.aws
# carries — and takes no API key. Its region comes from this URL, not AWS_REGION.
LLM_PROVIDER_BEDROCK_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
LLM_PROVIDER_BEDROCK_AUTH=sigv4

# --- MCP ------------------------------------------------------------------
# What lets the app reach the MCP containers at all. Their addresses resolve to
# private IPs, which the SSRF guard rejects unless the host's suffix is declared
# here. The value matches the cluster's because both environments sync the same
# agent-plugins registry, and its mcp.json names those hostnames.
MCP_INTERNAL_HOST_SUFFIXES=agent-mcps.svc.cluster.local

# --- Limits and tickers ---------------------------------------------------
MAX_RUN_DURATION_MS=600000
PLUGINS_REPO=opspresso/agent-plugins
PLUGINS_REPO_BRANCH=main
SLACK_LOADING_INDICATOR=:loading:

# --- Secrets --------------------------------------------------------------
# Not here. `scripts/deploy.sh` reads them from SSM — the same parameters
# External Secrets pulls into the cluster — and appends them to `.env` after
# everything above, so a name both carry resolves to SSM's value.
#
# One of them decides whether this instance works at all: AES_ENCRYPTION_KEY
# decrypts the credentials stored in this environment's own table. It comes from
# the same SSM parameter the cluster reads, so the two match; what matters here
# is that it stays the value that encrypted what is already stored. A different
# key does not fail at boot — it fails at every secret the table holds.
