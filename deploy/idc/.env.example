# The source of `.env`, which `scripts/deploy.sh` generates: this file with the
# image tags replaced by what argocd-env-demo pins (when GitHub is reachable),
# and the secrets appended — from `.env.secrets` on this host, or from SSM when
# the host has AWS credentials. Change a setting here and rerun the script —
# never in `.env`, which the next run overwrites.
#
# Compose reads `.env` twice: once to substitute the ${…} in compose.yaml
# (image tags, the registry, the profiles), and once as the app's env_file.
# Only `.env` is read for substitution — a variable compose.yaml names has to
# live here, not in .env.host or .env.mcp.example.

# --- Compose --------------------------------------------------------------
# `ticker` is the scheduler and the retention sweep: without it nothing fires
# schedules, purges expired rows or reindexes the catalog on this host.
# Add `aws` for the MCP servers that need an AWS account (memory, CloudWatch),
# `eks` for the ones that look back at a cluster.
COMPOSE_PROFILES=ticker,aws

# --- Images ---------------------------------------------------------------
# Where the app and its own MCP servers are pulled from. alpha pulls from ECR
# with the AWS key in .env.aws (deploy.sh logs in when it sees one); an
# installation elsewhere uses `ghcr.io/opspresso` (public images, no
# credentials) or the registry it mirrored the images into.
IMAGE_REGISTRY=396608815058.dkr.ecr.ap-northeast-2.amazonaws.com
# Placeholders. deploy.sh writes the versions argocd-env-demo pins for alpha
# when it can reach GitHub (FOLLOW_VERSIONS=false keeps these instead);
# otherwise a value here is what runs.
AGENT_STUDIO_TAG=v0.87.0-rc.4
MCP_MEMORY_TAG=v0.7.1
MCP_DOCUMENT_TAG=v0.10.0
MCP_YOUTUBE_TAG=v0.4.1
MCP_BRAVE_TAG=v2.1.3
MCP_CLOUDWATCH_TAG=0.1.8
MCP_ARGOCD_TAG=v0.9.0
MCP_GRAFANA_TAG=1.1.0
MCP_KUBERNETES_TAG=v0.0.66

# --- Core -----------------------------------------------------------------
# alpha and prod are the same check; only `local` skips it. Both require
# ADMIN_EMAILS and at least one way to sign in (below). An empty
# ALLOWED_EMAIL_DOMAINS is an unrestricted sign-in policy.
STAGE=alpha
ADMIN_EMAILS=me@nalbam.com
# ALLOWED_EMAIL_DOMAINS=nalbam.com

# Outward-facing URL. A2A Agent Cards, Slack manifests, OAuth callbacks, the
# MCP client-metadata document and proxied artifact links are built from it,
# and behind a proxy it cannot be inferred from the request.
BETTER_AUTH_URL=https://studio.opspresso.com
PUBLIC_BASE_URL=https://studio.opspresso.com

# The compose network, so Better Auth can strip Caddy's hop off X-Forwarded-For
# and rate-limit per client IP rather than putting every request in one bucket.
TRUSTED_PROXY_CIDRS=172.31.240.0/24

# --- Sign-in --------------------------------------------------------------
# Any combination. OIDC is what an enterprise directory speaks (Keycloak,
# Entra ID, Okta, Authentik …); the client id/secret come with the secrets
# below. Password sign-in is for the first administrator and for the day the
# provider is down — BOOTSTRAP_ADMIN_EMAIL is created on first boot with
# BOOTSTRAP_ADMIN_PASSWORD (a secret), and should be in ADMIN_EMAILS.
# OIDC_ISSUER=https://sso.example.com/realms/corp
# OIDC_DISPLAY_NAME=Corp SSO
AUTH_PASSWORD=true
BOOTSTRAP_ADMIN_EMAIL=me@nalbam.com

# --- Storage --------------------------------------------------------------
# Both on this host: PostgreSQL (DATABASE_URL is composed in compose.yaml from
# the password .env.host holds) and MinIO, addressed as any S3-compatible
# store. `proxied` serves artifact bytes through the app, so the object store
# is never reached from a browser — it has no public address here.
S3_BUCKET_NAME=agent-studio
ARTIFACT_ACCESS_MODE=proxied
AWS_REGION=ap-northeast-2

# --- Capability catalog ---------------------------------------------------
# On, with Cohere through Bedrock — this host has an AWS key. A deployment
# without one uses an OpenAI-compatible embedding model on its own channel
# (EMBEDDING_PROVIDER=openai, EMBEDDING_MODEL=<model>, EMBEDDING_DIM=<width>)
# and re-measures CATALOG_MIN_SCORE: a Korean query against an English
# description scores 0.39 on Cohere where Titan scores 0.065.
CATALOG_ENABLED=true
EMBEDDING_PROVIDER=cohere
EMBEDDING_MODEL=global.cohere.embed-v4:0
EMBEDDING_DIM=1024
CATALOG_MIN_SCORE=0.25

# --- Model catalog --------------------------------------------------------
# The published catalog, refreshed hourly. `none` turns the fetch off for a
# network that cannot reach it; the catalog is then uploaded on /models.
MODELS_CATALOG_URL=https://models.opspresso.com/models.json

# --- LLM channels ---------------------------------------------------------
LLM_BASE_URL=https://api.openai.com/v1
UNKNOWN_MODEL_POLICY=allow
LLM_PROVIDER_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
LLM_PROVIDER_OPENAI_BASE_URL=https://api.openai.com/v1
LLM_PROVIDER_GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_PROVIDER_XAI_BASE_URL=https://api.x.ai/v1
LLM_PROVIDER_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Signed with the process's AWS credentials — the same access key .env.aws
# carries — and takes no API key. Its region comes from this URL, not AWS_REGION.
LLM_PROVIDER_BEDROCK_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
LLM_PROVIDER_BEDROCK_AUTH=sigv4

# --- MCP ------------------------------------------------------------------
# What lets the app reach the MCP containers at all. Their addresses resolve to
# private IPs, which the SSRF guard rejects unless the host's suffix is declared
# here. The value matches the registry's mcp.json, which names those hostnames.
MCP_INTERNAL_HOST_SUFFIXES=agent-mcps.svc.cluster.local
# The same idea for the FetchUrl builtin — hosts a model may be allowed to
# read inside the network. A separate list on purpose; empty keeps the guard.
# URL_FETCH_INTERNAL_HOST_SUFFIXES=intranet.example.com

# mcp-memory's AWS resources (profile `aws`).
MEMORY_VECTOR_BUCKET=agent-studio-vector
MEMORY_STATE_BUCKET=agent-studio-memory
MEMORY_KNOWLEDGE_BASE_ID=C3NQOMBFVD

# --- Limits and tickers ---------------------------------------------------
MAX_RUN_DURATION_MS=600000
PLUGINS_REPO=opspresso/agent-plugins
PLUGINS_REPO_BRANCH=main
SLACK_LOADING_INDICATOR=:loading:

# --- Secrets --------------------------------------------------------------
# Not here. `scripts/deploy.sh` appends them to `.env` after everything above,
# from `.env.secrets` on this host (the file an operator writes, chmod 600) or
# from SSM when `.env.aws` is present and `.env.secrets` is not — so a name
# both carry resolves to the secret's value. `.env.secrets.example` lists them.
#
# One of them decides whether this instance works at all: AES_ENCRYPTION_KEY
# decrypts the credentials stored in this environment's own database. What
# matters is that it stays the value that encrypted what is already stored. A
# different key does not fail at boot — it fails at every secret the database
# holds.
