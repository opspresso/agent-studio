{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadDeploymentParameters",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath"
      ],
      "Resource": [
        "arn:aws:ssm:ap-northeast-2:396608815058:parameter/k8s/common/agentdure/*",
        "arn:aws:ssm:ap-northeast-2:396608815058:parameter/k8s/common/mcp-*"
      ]
    },
    {
      "Sid": "DecryptSecureStrings",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "ssm.ap-northeast-2.amazonaws.com"
        }
      }
    }
  ]
}
