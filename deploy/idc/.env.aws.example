# Copy to `.env.aws`. The IAM user's access key, shared by the three containers
# that call AWS: the app, mcp-memory and mcp-cloudwatch.
#
# It replaces EKS pod identity, which is why it is the one credential this
# deployment has that the cluster does not. Kept in its own file so the MCP
# containers get it without also getting the app's LLM keys and auth secrets.
#
# Rotating it means `docker compose up -d` — the SDK reads the environment once
# per process.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
