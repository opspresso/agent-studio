# The source of `.env`, which `scripts/deploy.sh` copies on first run and then
# keeps updating image tags in. The app's *base* configuration is the repo
# root's `.env.local` — compose loads that first and this file second, so a
# line here only exists to override what looks different from inside a
# container. Keep it that small.

# --- Compose --------------------------------------------------------------
# Empty by default: mcp-document and mcp-youtube need no credentials and are
# always on. Add profiles once their inputs exist:
#   aws    — mcp-memory + mcp-cloudwatch (cp .env.aws.example .env.aws first;
#            NOTE: mcp-memory then shares alpha's real memory buckets)
#   brave  — mcp-brave-search (set BRAVE_API_KEY below)
#   ticker — schedules, plugins sync, catalog reindex (needs
#            SCHEDULE_SCAN_TOKEN in .env.local)
COMPOSE_PROFILES=

# --- Image tags -----------------------------------------------------------
# Placeholders. deploy.sh writes what argocd-env-demo pins for alpha, so the
# laptop runs the same MCP images the cluster does; a value here is only what
# a run that could not reach GitHub falls back to.
ECR_REGISTRY=396608815058.dkr.ecr.ap-northeast-2.amazonaws.com
MCP_DOCUMENT_TAG=v0.9.0
MCP_YOUTUBE_TAG=v0.4.0
MCP_MEMORY_TAG=v0.7.0
MCP_CLOUDWATCH_TAG=0.1.8
MCP_BRAVE_TAG=v2.1.0
AWS_REGION=ap-northeast-2

# --- Container-view overrides ---------------------------------------------
# The Dockerfile sets NODE_ENV=production, which refuses to boot without an
# explicit STAGE; `local` keeps the fail-open admin default, so the
# dev-session cookie works here exactly as it does against `pnpm dev`.
STAGE=local

# The shared dev DynamoDB the root compose.yaml runs on the host's :8083 —
# same table as `pnpm dev`, reached through the host gateway.
DYNAMODB_ENDPOINT=http://host.docker.internal:8083

# What lets the app reach the MCP containers at all: agent-plugins' mcp.json
# names `mcp-<name>.agent-mcps.svc.cluster.local`, which resolves here via the
# compose network aliases, and this declaration is what takes those names past
# the SSRF guard.
MCP_INTERNAL_HOST_SUFFIXES=agent-mcps.svc.cluster.local

# Off on purpose, even if .env.local turns it on for `pnpm dev`: the managed
# runtime shells out to the `docker` CLI, which the app image does not carry,
# and its 127.0.0.1 addresses would be the container's own loopback anyway.
MANAGED_MCP_INSTANCE_ID=
MANAGED_MCP_REGISTRY=

# If LLM_BASE_URL (or a provider channel) in .env.local points at the host's
# loopback — mock-llm on :8002, LM Studio on :1234 — re-state it here through
# the host gateway; a cloud URL needs nothing.
# LLM_BASE_URL=http://host.docker.internal:1234/v1
# LLM_PROVIDER_SELFHOSTED_BASE_URL=http://host.docker.internal:1234/v1

# --- Profile inputs -------------------------------------------------------
# BRAVE_API_KEY=
