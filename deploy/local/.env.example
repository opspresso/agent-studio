# The source of `.env`, which `scripts/deploy.sh` copies on first run and then
# reads the pinned image tags from. Everything here is compose's — the app is
# `pnpm dev` on the host and keeps reading the repo root's `.env.local`, where
# the one line this setup needs is:
#
#   MCP_INTERNAL_HOST_SUFFIXES=agent-mcps.svc.cluster.local

# --- Compose --------------------------------------------------------------
# Empty by default: mcp-document and mcp-youtube need no credentials and are
# always on. Add profiles once their inputs exist:
#   aws    — mcp-memory + mcp-cloudwatch (cp .env.aws.example .env.aws first;
#            mcp-memory uses the root compose project's PostgreSQL)
#   brave  — mcp-brave-search (set BRAVE_API_KEY below)
#   ticker — schedules, plugins sync, catalog reindex against the host's
#            `pnpm dev` (set SCHEDULE_SCAN_TOKEN below)
COMPOSE_PROFILES=

# --- Image tags -----------------------------------------------------------
# Explicit local versions. deploy.sh pulls these tags without consulting
# deployment repositories; change them here to update the local MCP servers.
ECR_REGISTRY=396608815058.dkr.ecr.ap-northeast-2.amazonaws.com
MCP_DOCUMENT_TAG=v0.11.1
MCP_YOUTUBE_TAG=v0.4.2
MCP_MEMORY_TAG=v0.9.0
MCP_CLOUDWATCH_TAG=0.1.8
MCP_BRAVE_TAG=v2.1.3
AWS_REGION=ap-northeast-2

# --- Profile inputs -------------------------------------------------------
# BRAVE_API_KEY=
# The same value .env.local's SCHEDULE_SCAN_TOKEN carries — the ticker gets
# only this one variable, not the whole app env.
# SCHEDULE_SCAN_TOKEN=
