# Local MCP deployment. Agent Studio runs on the host with .env.local.
# Keep credentials in ignored .env files; never copy them into .example files.

# --- Enabled services -----------------------------------------------------
# Available: aws,argocd,grafana,kubernetes,ticker
# Enable a profile only after its settings below are complete.
# Example with AWS credentials and ticker token: COMPOSE_PROFILES=aws,ticker
COMPOSE_PROFILES=

# --- Public image versions ------------------------------------------------
# No private ECR login is required.
MCP_CLOUDWATCH_TAG=0.1.8
MCP_ARGOCD_TAG=v0.9.0
MCP_GRAFANA_TAG=1.1.0
MCP_KUBERNETES_TAG=v0.0.66

# --- CloudWatch (aws) -----------------------------------------------------
# AWS access keys belong in .env.aws, which only CloudWatch receives.
AWS_REGION=ap-northeast-2

# --- Argo CD (argocd, read-only tools) ------------------------------------
# The URL must be reachable from a container. For a service on this Mac,
# use host.docker.internal rather than localhost.
# Example: https://argocd.example.com or http://host.docker.internal:8080
ARGOCD_BASE_URL=
ARGOCD_API_TOKEN=

# --- Grafana (grafana, read-only tools) -----------------------------------
# Example: https://grafana.example.com or http://host.docker.internal:3101
GRAFANA_URL=
GRAFANA_SERVICE_ACCOUNT_TOKEN=

# --- Kubernetes (kubernetes, read-only tools) -----------------------------
# Absolute path to a dedicated, self-contained kubeconfig with only the
# intended context. Host-side exec credential helpers are not bundled.
# Example: /absolute/path/to/dedicated-local-kubeconfig
KUBECONFIG_PATH=

# --- Scheduler (ticker) ---------------------------------------------------
# Must match SCHEDULE_SCAN_TOKEN in the repository root's .env.local.
SCHEDULE_SCAN_TOKEN=
