{
  "family": "agent-studio",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/agent-studio-execution",
  "taskRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/agent-studio-task",
  "containerDefinitions": [
    {
      "name": "agent-studio",
      "image": "<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/agent-studio:latest",
      "essential": true,
      "portMappings": [{ "containerPort": 3000, "protocol": "tcp" }],
      "environment": [
        { "name": "STAGE", "value": "prod" },
        { "name": "AWS_REGION", "value": "<REGION>" },
        { "name": "DYNAMODB_TABLE_NAME", "value": "agent-studio" },
        { "name": "BETTER_AUTH_URL", "value": "https://<YOUR_DOMAIN>" },
        { "name": "ALLOWED_EMAIL_DOMAINS", "value": "nalbam.com" }
      ],
      "secrets": [
        { "name": "BETTER_AUTH_SECRET", "valueFrom": "arn:aws:ssm:<REGION>:<ACCOUNT_ID>:parameter/agent-studio/BETTER_AUTH_SECRET" },
        { "name": "GOOGLE_CLIENT_ID", "valueFrom": "arn:aws:ssm:<REGION>:<ACCOUNT_ID>:parameter/agent-studio/GOOGLE_CLIENT_ID" },
        { "name": "GOOGLE_CLIENT_SECRET", "valueFrom": "arn:aws:ssm:<REGION>:<ACCOUNT_ID>:parameter/agent-studio/GOOGLE_CLIENT_SECRET" },
        { "name": "LLM_BASE_URL", "valueFrom": "arn:aws:ssm:<REGION>:<ACCOUNT_ID>:parameter/agent-studio/LLM_BASE_URL" },
        { "name": "LLM_API_KEY", "valueFrom": "arn:aws:ssm:<REGION>:<ACCOUNT_ID>:parameter/agent-studio/LLM_API_KEY" },
        { "name": "AES_ENCRYPTION_KEY", "valueFrom": "arn:aws:ssm:<REGION>:<ACCOUNT_ID>:parameter/agent-studio/AES_ENCRYPTION_KEY" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -qO- http://127.0.0.1:3000/api/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 10
      },
      "stopTimeout": 120,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/agent-studio",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "app"
        }
      }
    }
  ]
}
