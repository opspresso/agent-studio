# Stage: local | alpha | prod
STAGE=local

# Note: ADMIN_EMAILS, ALLOWED_EMAIL_DOMAINS, LLM_BASE_URL, LLM_API_KEY,
# LLM_PROVIDER_*, SKILLS_REPO, SKILLS_REPO_BRANCH, TOOLS_REPO, TOOLS_REPO_BRANCH,
# GITHUB_TOKEN, A2A_API_KEY, PUBLIC_BASE_URL and UNKNOWN_MODEL_POLICY can be
# overridden at runtime on the admin /settings page; DB overrides take
# precedence over these env values.

AWS_REGION=ap-northeast-2

# DynamoDB
DYNAMODB_TABLE_NAME=agent-studio
# Local development only (DynamoDB Local). 8083 is the dev instance; the
# integration check uses the separate 8084 one with the `agent-studio-test`
# table. Both instances are shared with the other projects on this machine, so
# the table name above is what keeps this app's rows apart (compose.yaml).
# Must be empty in alpha/prod — a leftover value sends the app at a localhost
# that is not there.
DYNAMODB_ENDPOINT=http://localhost:8083

# Row retention (days) — TTL on the table's expiresAt attribute. Optional
# overrides for the defaults shown; trace / usage / chat+message / inbound A2A
# task / trigger delivery / audit record. Audit is kept as long as usage: the
# question an audit row answers is asked long after the act.
# TRACE_RETENTION_DAYS=30
# USAGE_RETENTION_DAYS=400
# CHAT_RETENTION_DAYS=180
# A2A_TASK_RETENTION_DAYS=1
# TRIGGER_RUN_RETENTION_DAYS=30
# AUDIT_RETENTION_DAYS=400

# Schedule trigger ticker. Unset means this deployment has no ticker: schedule
# triggers never fire and POST /api/triggers/scan answers 503. Set it and have
# something POST the endpoint about once a minute (K8s CronJob in production,
# a curl loop in dev) with the X-Scan-Token header.
# SCHEDULE_SCAN_TOKEN=

# S3 bucket for generated chat images (optional, public-read). Unset disables
# image persistence; chat images then render only during the live stream.
S3_BUCKET_NAME=

# Better Auth
# BETTER_AUTH_SECRET: `npx @better-auth/cli secret`로 생성.
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LLM channel (OpenAI-compatible router)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=

# Secret encryption for MCP / external agent headers (32-byte base64)
AES_ENCRYPTION_KEY=

# Wall-clock cap for a single run, in ms (positive integer; default 600000 = 10 min).
# Bounds every execution path so a hung provider or tool call cannot run unbounded;
# an invalid value is ignored with a warning.
# MAX_RUN_DURATION_MS=600000
# Runs one caller may have in flight at once. A2A has its own ceiling because
# its inbound key is shared, so one identity stands for every machine caller.
# 0 disables a limit.
# MAX_CONCURRENT_RUNS_PER_ACTOR=10
# MAX_CONCURRENT_RUNS_A2A=50

# Trace sampling for non-agent predict runs (0–1). Agent runs are always traced.
TRACE_SAMPLE_RATE=0.1

# OTLP trace export (optional). When the endpoint is set, every persisted trace
# is also exported as OTEL spans (after the DynamoDB write); unset means no
# export and the OTEL SDK is never loaded. Headers are `key=value,key2=value2`,
# case-preserved — they carry collector credentials.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=

# In-memory TTL for the runtime settings row, in ms (positive; default 5000).
# Cache invalidation on write is process-local, so on a multi-instance
# deployment this bounds how long a demoted admin or a rotated A2A key keeps
# working on instances that did not serve the write.
# SETTINGS_CACHE_TTL_MS=5000

# In-memory TTL for a bound MCP server's tool list, in ms (>= 0; default 60000;
# 0 disables caching). A warm entry also lets the session handshake lazily, so a
# turn that calls no tool makes no MCP request. Registry edits invalidate the
# entry on the instance that served them; this TTL bounds the others.
# MCP_DISCOVERY_CACHE_TTL_MS=60000

# Ceiling on the `ttlMs` a server may ask for on tools/list (SEP-2549), in ms
# (>= 0; default 300000). A server knows its own catalogue, but the same number
# also bounds how long a registry edit goes unseen on the other instances — that
# part belongs to the deployment. 0 ignores server hints entirely and keeps the
# local TTL for everything.
# MCP_MAX_SERVER_TTL_MS=300000

# Restrict sign-in to these email domains (comma-separated). Empty allows all.
ALLOWED_EMAIL_DOMAINS=

# Emails allowed to mutate shared registries: MCP servers, external agents,
# skills (comma-separated). Empty allows any signed-in user.
ADMIN_EMAILS=

# Reverse proxies in front of this deployment (comma-separated IPs/CIDRs, e.g.
# the VPC CIDR when ALB + Istio both append to X-Forwarded-For). Better Auth
# strips these hops to resolve the client IP its rate limiting keys on; empty
# trusts only a single-value header, so behind two proxies every request falls
# into one shared bucket.
# TRUSTED_PROXY_CIDRS=

# Optional per-provider channels. Model ids "provider/model" route to the
# matching LLM_PROVIDER_<PROVIDER>_* channel when registered; anything else
# uses the default LLM_BASE_URL channel with the full model id. Provider
# channels receive the bare model name (prefix stripped) unless
# LLM_PROVIDER_<PROVIDER>_KEEP_MODEL_PREFIX=true.
# LLM_PROVIDER_OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_PROVIDER_OPENAI_API_KEY=
# LLM_PROVIDER_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# LLM_PROVIDER_ANTHROPIC_API_KEY=
# LLM_PROVIDER_GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_PROVIDER_GOOGLE_API_KEY=
# LLM_PROVIDER_XAI_BASE_URL=https://api.x.ai
# LLM_PROVIDER_XAI_API_KEY=

# What to do with a model id the registry cannot price: allow (default) runs it
# and books the usage at $0; refuse rejects the run before it dispatches. Turn
# this on where the usage rows become an invoice.
# UNKNOWN_MODEL_POLICY=allow

# GitHub skills source repo (optional). Skills live at skills/<name>/SKILL.md.
# A sync imports what is missing and reports the rest; an existing skill is
# rewritten only when the caller names it for overwrite.
SKILLS_REPO=
SKILLS_REPO_BRANCH=main

# GitHub tools source repo (optional). Tools live at tools/<name>/TOOL.md, whose
# frontmatter carries `url` and `description`; the body becomes operator notes.
# Same sync rule — and an overwrite replaces only those fields: an MCP entry
# also holds encrypted headers and a discovered OAuth block, which stay put.
# A cluster-internal url needs MCP_INTERNAL_HOST_SUFFIXES below.
TOOLS_REPO=
TOOLS_REPO_BRANCH=main

# Read access to both repos above.
GITHUB_TOKEN=

# What a Slack reply carries while it is still being written; the final edit
# drops it. Default is a built-in emoji, because a custom name a workspace has
# not defined renders as its own literal text.
# SLACK_LOADING_INDICATOR=:hourglass_flowing_sand:

# A2A (optional). Shared key for inbound A2A JSON-RPC calls (X-A2A-Key header).
# The surface is off only when this is unset AND no named client key has been
# issued (/settings → Client keys). Agent Card URLs use PUBLIC_BASE_URL.
A2A_API_KEY=

# Public base URL for outward-facing URLs (e.g. A2A Agent Card). Unset falls
# back to the request origin.
PUBLIC_BASE_URL=

# DNS suffixes whose hosts an MCP entry may use even though they resolve to a
# private address — Kubernetes Service names, typically
# <namespace>.svc.cluster.local. Comma-separated; empty leaves the SSRF guard
# unchanged. Matching is anchored on a label boundary, single-label suffixes and
# IP literals are refused, and this is env-only on purpose: widening the outbound
# boundary should take a deploy. See docs/SECURITY.md.
# MCP_INTERNAL_HOST_SUFFIXES=agent-mcps.svc.cluster.local

# Managed MCP (optional). Containers this app starts on its own host through SSM,
# reached on loopback. Both unset means the feature is off — the routes answer 503
# rather than half-enable it. The registry is the one `docker login` authenticates
# against; images may come from any registry the host can pull from.
MANAGED_MCP_INSTANCE_ID=
MANAGED_MCP_REGISTRY=
# The container managed workloads share a network namespace with — this app's
# own (default `agent-studio`). Every container has its own 127.0.0.1, so a
# loopback address only means anything when both ends are in the same namespace.
# Sharing one also means a single app instance per host.
# MANAGED_MCP_NETWORK_CONTAINER=agent-studio
