# Stage: local | alpha | prod
STAGE=local

# DynamoDB
AWS_REGION=ap-northeast-2
DYNAMODB_TABLE_NAME=agent-studio
# Local development only (DynamoDB Local)
DYNAMODB_ENDPOINT_URL=http://localhost:8000

# Better Auth
# BETTER_AUTH_SECRET: `npx @better-auth/cli secret`로 생성.
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LLM channel (OpenAI-compatible router)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=

# Secret encryption for MCP / external agent headers (32-byte base64)
AES_ENCRYPTION_KEY=

# Restrict sign-in to these email domains (comma-separated). Empty allows all.
ALLOWED_EMAIL_DOMAINS=

# Optional per-provider channels. Model ids "provider/model" route to the
# matching LLM_PROVIDER_<PROVIDER>_* channel when registered; anything else
# uses the default LLM_BASE_URL channel with the full model id. Provider
# channels receive the bare model name (prefix stripped) unless
# LLM_PROVIDER_<PROVIDER>_KEEP_MODEL_PREFIX=true.
# LLM_PROVIDER_OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_PROVIDER_OPENAI_API_KEY=
# LLM_PROVIDER_GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_PROVIDER_GOOGLE_API_KEY=
# LLM_PROVIDER_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# LLM_PROVIDER_ANTHROPIC_API_KEY=

# Slack integration (one bot per workspace). Events endpoint: /api/slack/events
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_DEFAULT_PROJECT=

# GitHub skills source repo (optional). Skills live at skills/<name>/SKILL.md.
SKILLS_REPO=
SKILLS_REPO_BRANCH=main
GITHUB_TOKEN=

# A2A (optional). Shared key for inbound A2A JSON-RPC calls (X-A2A-Key header);
# unset disables the /api/a2a endpoints. Agent Card URLs use PUBLIC_BASE_URL.
A2A_API_KEY=
