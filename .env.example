# Application settings
# Copy to .env.local, then fill required secrets. Never commit the filled file.
# Active values configure local PostgreSQL and MinIO from compose.yaml.
# Commented assignments are optional; their comments distinguish defaults from examples.
# Full reference: docs/CONFIGURATION.md. Setup: docs/DEVELOPMENT.md.
# Compose MCP settings and credentials belong in deploy/local/.env and .env.aws.
#
# Settings DB overrides take precedence for supported fields (including LLM
# channels, artifact access, plugin source and access settings). Model selections
# in Settings → Models also override embedding/reranker choices. Editing env alone may not
# change an overridden value; check each field's source in the console.

# --- Application and public URLs ------------------------------------------
# local | alpha | prod. Production requires an explicit STAGE.
# alpha/prod also require ADMIN_EMAILS and at least one sign-in provider.
STAGE=local
# Display name and matching asset folder under public/brands/.
# These are independent: use AgentOps/agentops, or add another complete folder.
# SERVICE_NAME=Agent Studio
# SERVICE_LOGO=agent-studio
BETTER_AUTH_URL=http://localhost:3000
# Example: https://studio.example.com. Used for artifact links and agent URLs.
# When empty, uses BETTER_AUTH_URL; some request-bound paths use request origin.
PUBLIC_BASE_URL=

# --- Database (required) --------------------------------------------------
# Start services: docker compose up -d postgres minio minio-init
# Schema and pgvector are initialized at app boot. Tests use agent_studio_test.
DATABASE_URL=postgres://agent_studio:agent_studio@localhost:5432/agent_studio
# Default connections per app instance.
# DATABASE_POOL_SIZE=10

# --- Encryption and session signing ---------------------------------------
# Generate each secret independently: openssl rand -base64 32
# AES_ENCRYPTION_KEY must decode to exactly 32 bytes; required at boot.
# Keep it stable for stored credentials and signed object URLs.
AES_ENCRYPTION_KEY=
# Session signing secret. Set a generated value before using authentication.
BETTER_AUTH_SECRET=

# --- Sign-in and access ---------------------------------------------------
# Comma-separated domain allowlist; empty permits any email domain.
ALLOWED_EMAIL_DOMAINS=
# Example: admin@example.com. Required for alpha/prod.
# Empty in local leaves shared registry/settings access unrestricted; it does
# not grant a project-owner override. Configured members become admin tier.
ADMIN_EMAILS=

# Google: configure both values to enable it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Keycloak: configure all three values; can be used alongside Google.
# Register BETTER_AUTH_URL/api/auth/callback/keycloak as the redirect URI.
# KEYCLOAK_ISSUER=https://sso.example.com/realms/corp
# KEYCLOAK_CLIENT_ID=agent-studio
# KEYCLOAK_CLIENT_SECRET=

# OIDC example: configure issuer, client ID and client secret together.
# Use either KEYCLOAK_* or OIDC_* for the same realm, not both.
# OIDC_ISSUER=https://sso.example.com/realms/corp
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_DISPLAY_NAME=SSO
# OIDC_SCOPES=openid email profile

# Local password sign-in (default false). No public sign-up form.
# Bootstrap creates the initial account; it does not reset an existing password.
# Add the bootstrap email to ADMIN_EMAILS for an administrator account.
# AUTH_PASSWORD=true
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=

# Reverse-proxy example: only list trusted forwarding proxies, not end users.
# TRUSTED_PROXY_CIDRS=10.0.0.0/8

# --- Model registration (required for runs) -------------------------------
# Register a provider connection and select its model in Settings → Models.
# For a local mock, connect http://127.0.0.1:8002/v1 with a non-empty dummy key,
# then run: pnpm tsx scripts/mock-llm.ts
# The mock checks UI/transport flows; it does not perform real document tasks.
# Provider connections and registrations are managed in /settings/providers and /settings/models;
# default, Decision, Workspace and retrieval selections are in /settings/model-usage.
# allow (default) | refuse: whether registered models without known pricing may run.
# An unregistered model is always rejected, regardless of this policy.
# UNKNOWN_MODEL_POLICY=allow
# Disable optional public catalog refresh on isolated installs.
# PUBLISHED_MODELS_REFRESH=off

# --- Provider-specific LLM channels (optional) -----------------------------
# These values seed provider connections only when no connections are stored in Settings.
# Runs use registered models and their selected provider connection; there is no
# default-channel fallback. The wire ID is sent unless
# LLM_PROVIDER_<NAME>_KEEP_MODEL_PREFIX=true. Bearer connections need a key.
# Values below are endpoint examples, not enabled defaults.
# LLM_PROVIDER_OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_PROVIDER_OPENAI_API_KEY=
# LLM_PROVIDER_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# LLM_PROVIDER_ANTHROPIC_API_KEY=
# LLM_PROVIDER_GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_PROVIDER_GOOGLE_API_KEY=
# LLM_PROVIDER_XAI_BASE_URL=https://api.x.ai/v1
# LLM_PROVIDER_XAI_API_KEY=
# LLM_PROVIDER_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# LLM_PROVIDER_OPENROUTER_API_KEY=

# Self-hosted example. Register the endpoint's models in /settings/models.
# LLM_PROVIDER_SELFHOSTED_BASE_URL=http://vllm.corp.internal:8000/v1
# LLM_PROVIDER_SELFHOSTED_API_KEY=not-required
# LLM_PROVIDER_SELFHOSTED_KEEP_MODEL_PREFIX=false

# Bedrock Mantle example: SigV4 uses AWS credentials, not an API key.
# The signing region comes from the endpoint URL. This route serves Bedrock's
# OpenAI-compatible models; Claude's Anthropic Messages API is a different route.
# LLM_PROVIDER_BEDROCK_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
# LLM_PROVIDER_BEDROCK_AUTH=sigv4

# --- File storage --------------------------------------------------------
# Local MinIO credentials match compose.yaml. Use deployment-specific values elsewhere.
# Storage enables original attachment retention and File/SaveFile tools.
# Without storage, attachment text extraction remains available.
S3_BUCKET_NAME=agent-studio
# Audio files and derived results reuse this bucket as private Artifacts.
# Use a private, unversioned bucket and authenticated/proxied access; see docs/INSTALL.md.
# Optional dedicated ASR endpoint; otherwise a matching provider channel is required.
# TRANSCRIPTION_RESPONSE_FORMAT=json
# TRANSCRIPTION_CHUNKING_STRATEGY=auto
# TRANSCRIPTION_MAX_INPUT_BYTES=26214400
# TRANSCRIPTION_SEGMENT_SECONDS=300
# FFMPEG_PATH=ffmpeg
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=agent_studio
S3_SECRET_ACCESS_KEY=agent_studio_secret
# proxied: app serves signed links; authenticated: browser accesses signed S3 URLs;
# public: requires a public-read bucket. Download URLs are still signed.
# Local choice below is proxied; the code default when unset is authenticated.
ARTIFACT_ACCESS_MODE=proxied
# Optional public-object base URL, when different from the endpoint.
# S3_PUBLIC_BASE_URL=https://files.example.com
# Native document workers and PDF fonts are bundled; no document MCP is required.
# Worker limits are fixed in code, not DOCUMENT_WORKER_* environment variables.

# --- AWS -----------------------------------------------------------------
AWS_REGION=ap-northeast-2
# Bedrock uses the SDK credential chain: profile, environment or workload role.
# These optional examples are consumed by the AWS SDK, not app config getters.
# AWS_PROFILE=your-development-profile
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# MinIO uses S3_* above; do not reuse its keys as AWS credentials.

# --- Capability catalog and embedding ------------------------------------
# Default false. Enable only with a working embedding endpoint/model.
# CATALOG_ENABLED=true
# Select registered Embedding/Rerank models in /settings/model-usage.
# All model types, including self-hosted retrieval, use their registered provider connection.
# Default 1024. Use native to omit dimensions for a model that rejects that parameter.
# Changing the model or vector width requires a catalog reindex.
# EMBEDDING_DIM=1024
# Default 0.25, clamped to [0,1]. Measure again for each embedding model.
# CATALOG_MIN_SCORE=0.25

# --- Reranker (optional) --------------------------------------------------
# Register a rerank provider and select its model in /settings/model-usage.
# Default 0.01, clamped to [0,1]. Re-measure after changing the model.
# RERANKER_MIN_SCORE=0.01

# --- Plugin repository and GitHub -----------------------------------------
# Example repository: opspresso/agent-plugins. Remote sync requires repo + token.
# Sync creates/updates declared items; deleting orphaned items requires selection.
# Offline alternative: upload a checkout .tar.gz on /plugins.
PLUGINS_REPO=
PLUGINS_REPO_BRANCH=main
GITHUB_TOKEN=
# GitHub Enterprise examples; unset API defaults to https://api.github.com.
# GITHUB_API_URL=https://github.example.com/api/v3
# GITHUB_WEB_URL=https://github.example.com

# --- MCP and outbound access ---------------------------------------------
# Permit only intended internal DNS suffixes. This allowlist does not configure DNS.
# localhost is an exact-host exception; other single-label suffixes and IPs are refused.
# Local Compose MCP example:
# MCP_INTERNAL_HOST_SUFFIXES=agent-mcps.svc.cluster.local,localhost
# FetchUrl has a separate allowlist. Example:
# URL_FETCH_INTERNAL_HOST_SUFFIXES=wiki.corp.internal
# MCP tool-list cache defaults, in milliseconds. 0 disables caching / server hints.
# MCP_DISCOVERY_CACHE_TTL_MS=60000
# MCP_MAX_SERVER_TTL_MS=300000
# Default false. Enable only for an OAuth server that supports PKCE but does
# not advertise code_challenge_methods_supported. See docs/SECURITY.md.
# MCP_OAUTH_ALLOW_UNADVERTISED_PKCE=false

# Managed MCP is independent of deploy/local Compose. Both values are required.
# MANAGED_MCP_RUNTIME=docker
# MANAGED_MCP_REGISTRY=registry.example.com/mcp

# --- Messaging ------------------------------------------------------------
# Optional Slack in-progress indicator; unset uses a built-in emoji.
# SLACK_LOADING_INDICATOR=:hourglass_flowing_sand:

# --- Scheduler and retention ---------------------------------------------
# A configured token plus an external ticker runs schedules, plugin sync and
# catalog reindex. It also sweeps expired DB rows; no ticker means no DB purge.
# The ticker sends X-Scan-Token. Match deploy/local/.env for local execution.
# SCHEDULE_SCAN_TOKEN=
# Default retention periods in days. Usage has a 31-day minimum; others below have 1.
# TRACE_RETENTION_DAYS=30
# USAGE_RETENTION_DAYS=400
# CHAT_RETENTION_DAYS=180
# TRIGGER_RUN_RETENTION_DAYS=30
# AUDIT_RETENTION_DAYS=400
# ARTIFACT_RETENTION_DAYS=180
# Object-store lifecycle expiry is configured separately. Align artifact row
# retention with bucket expiry; chat deletion does not delete artifact objects.

# --- Execution limits and diagnostics ------------------------------------
# Defaults. Run deadline uses milliseconds; concurrency 0 disables that limit.
# MAX_RUN_DURATION_MS=600000
# MAX_CONCURRENT_RUNS_PER_ACTOR=10
# Runtime settings cache; positive milliseconds, default 5000.
# SETTINGS_CACHE_TTL_MS=5000
# Optional OTLP export. No endpoint means no trace export.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector.corp.internal:4318/v1/traces
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <token>

# --- Persistent Workspaces (optional; see docs/design/workspaces.md) ------
# Run a separate worker: node --env-file=.env.local --import tsx scripts/workspace-worker.ts
# Workspace tools are enabled in the Agent configuration; configure repositories in its Workspace tab and models in Models.
# WORKSPACE_IMAGE=agent-studio-workspace:agents
# WORKSPACE_NETWORK=none
# WORKSPACE_DOCKER_CONTEXT=workspace
# WORKSPACE_MEMORY_MB=2048
# WORKSPACE_DISK_MB=2048
# WORKSPACE_CPUS=2
# WORKSPACE_WORKER_CONCURRENCY=4
# WORKSPACE_RETENTION_DAYS=180
# Account Git credentials stay on the server. Alternatively configure a GitHub App.
# WORKSPACE_GITHUB_AUTH=token
# WORKSPACE_GITHUB_APP_ID=
# WORKSPACE_GITHUB_INSTALLATION_ID=
# WORKSPACE_GITHUB_PRIVATE_KEY=
# WORKSPACE_GITHUB_WEBHOOK_SECRET=
# WORKSPACE_GITHUB_INTERNAL_HOSTS=github.corp.internal
