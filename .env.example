# Stage: local | alpha | prod
STAGE=local

# Note: ADMIN_EMAILS, ALLOWED_EMAIL_DOMAINS, LLM_BASE_URL, LLM_API_KEY,
# LLM_PROVIDER_*, PLUGINS_REPO, PLUGINS_REPO_BRANCH, GITHUB_TOKEN, A2A_API_KEY,
# PUBLIC_BASE_URL and UNKNOWN_MODEL_POLICY can be overridden at runtime on the
# admin /settings page; DB overrides take precedence over these env values.

# --- Database (required) ---------------------------------------------------
# PostgreSQL with the pgvector extension — the one store this app needs. The
# schema is created and migrated at boot. `docker compose up -d postgres`
# serves this URL locally; the integration check uses `agent_studio_test` on
# the same server.
DATABASE_URL=postgres://agent_studio:agent_studio@localhost:5432/agent_studio
# Connections one instance holds open (default 10).
# DATABASE_POOL_SIZE=10

# Row retention (days) — rows carry an `expiresAt`, and the scheduler tick
# (SCHEDULE_SCAN_TOKEN) sweeps the expired ones. Optional overrides for the
# defaults shown; trace / usage / chat+message / inbound A2A task / trigger
# delivery / audit record. Audit is kept as long as usage: the question an
# audit row answers is asked long after the act.
# TRACE_RETENTION_DAYS=30
# USAGE_RETENTION_DAYS=400
# CHAT_RETENTION_DAYS=180
# A2A_TASK_RETENTION_DAYS=1
# TRIGGER_RUN_RETENTION_DAYS=30
# AUDIT_RETENTION_DAYS=400
# Rows naming what runs produced. Keep at or above CHAT_RETENTION_DAYS: shorter
# and an image still visible in a conversation leaves its own gallery first.
# ARTIFACT_RETENTION_DAYS=180

# Shared token for every endpoint a ticker POSTs, sent as X-Scan-Token. Unset
# means this deployment has no ticker and all three answer 503 — and nothing
# sweeps expired rows:
#   /api/triggers/scan      schedule triggers + the retention sweep — once a minute
#   /api/plugins/sync/scan  the plugins repo — rides the same minute tick
#   /api/catalog/reindex    the capability catalog — hourly is ample
# Trimmed on read, so a value mounted from a file keeps working despite its
# trailing newline.
# SCHEDULE_SCAN_TOKEN=

# --- Object store ----------------------------------------------------------
# Agent Studio local development uses the MinIO in compose.yaml. A deployment repository replaces
# these values with that environment's S3-compatible store.
#
# S3_ENDPOINT names a store other than AWS (MinIO, Garage, Ceph RGW), addressed
# path-style; unset means AWS with the SDK's own region/credential resolution.
# The store's own key pair is S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY — not
# AWS_*, which every other AWS client in the process (Bedrock) reads; unset,
# the SDK's default chain applies, which is right for AWS itself.
# `docker compose up -d postgres minio minio-init` starts MinIO and creates the bucket.
S3_BUCKET_NAME=agent-studio
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=agent_studio
S3_SECRET_ACCESS_KEY=agent_studio_secret
# How a reader reaches an object: `proxied` (the app streams the bytes through
# a signed app URL — the store needs no public address; the choice for an
# installation), `authenticated` (pre-signed store URLs — the store must be
# reachable from browsers), `public` (direct URLs — a public-read bucket).
ARTIFACT_ACCESS_MODE=proxied
# The base readers reach public objects at, when it differs from S3_ENDPOINT.
# S3_PUBLIC_BASE_URL=
AWS_REGION=ap-northeast-2

# --- Capability catalog (optional) -----------------------------------------
# One global index of every skill, MCP server and external agent, kept in the
# database (pgvector). A version with `dynamicCapabilities` on searches it with
# its system prompt and the incoming request, and is offered what it finds on
# top of its own bindings — which are always offered in full and never
# displaced. Off by default: /api/catalog/reindex answers 503 and every run
# offers exactly what its version bound. Turning it on says this deployment
# has an embedding model its channel can serve.
#
# A completed plugins sync reindexes as well, so a merge to the plugins repo is
# discoverable without waiting for the hourly tick.
# CATALOG_ENABLED=true

# Which service turns text into a vector: openai | cohere | bedrock. `openai`
# uses EMBEDDING_BASE_URL / EMBEDDING_API_KEY when the base URL is set, or
# reuses LLM_BASE_URL / LLM_API_KEY otherwise. The endpoint has to serve
# /embeddings — a self-hosted vLLM/TEI/Ollama works. The other two are Bedrock
# and need AWS credentials.
#
# Every row of the index must come from one model: changing the model means a
# reindex, because vectors from two models are not comparable and nothing in a
# mixed index reports that — the scores are simply wrong.
# The value is the registry id shown on /models. An admin selection there is a
# DB override and performs the required reindex after explicit confirmation.
#
# Which one to pick is measured, not preference: on a registry described in
# English and queried in Korean, only Cohere v4 puts a correct answer clear of
# its own noise floor. The measurements are in docs/CONFIGURATION.md
# ("Choosing an embedding model") — re-measure before changing this, and
# change CATALOG_MIN_SCORE with it. Qwen3-Embedding-4B measured 0.81–0.83 for
# direct matches and 0.25–0.46 for unrelated entries here, so it uses 0.5.
# EMBEDDING_PROVIDER=openai
# EMBEDDING_BASE_URL=http://embedding.corp.internal:8001/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=openrouter/text-embedding-3-small
# Use `native` for a model that rejects the dimensions request parameter.
# EMBEDDING_DIM=1024

# The relevance floor a catalog hit has to clear, in (0, 1]. This one belongs to
# the embedding model rather than to the search, and it does not transfer: the
# default is Cohere v4's number and admits everything under a model whose scale
# sits lower. Re-measure it whenever EMBEDDING_MODEL changes.
# CATALOG_MIN_SCORE=0.25

# Optional second-stage ranking of the vector candidates. Configure the base
# URL and model together; an unauthenticated local vLLM endpoint needs no key.
# The model is a registry id; /models can override the env default by type.
# RERANKER_BASE_URL=http://reranker.corp.internal:8002/v1
# RERANKER_API_KEY=
# RERANKER_MODEL=selfhosted/Qwen/Qwen3-Reranker-0.6B
# RERANKER_MIN_SCORE=0.01

# --- Model catalog ---------------------------------------------------------
# Optional URL where the model registry is published (agent-models). When set,
# fetched at boot and on the interval; otherwise the committed snapshot serves.
# `none` explicitly keeps the fetch off. An admin can upload catalog JSON on
# /models, and that upload wins over the network everywhere.
# MODELS_CATALOG_URL=https://models.opspresso.com/models.json
# MODELS_CATALOG_REFRESH_MS=3600000

# --- Sign-in ---------------------------------------------------------------
# BETTER_AUTH_SECRET: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000
# Any combination of the three; alpha/prod refuse to boot with none. Locally
# `pnpm tsx scripts/dev-session.ts` prints a session cookie without any.
#
# A standard OIDC provider — Keycloak, Entra ID, Okta, Authentik, anything with
# a discovery document at <issuer>/.well-known/openid-configuration.
# OIDC_ISSUER=https://sso.example.com/realms/corp
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_DISPLAY_NAME=Corp SSO
# OIDC_SCOPES=openid email profile
# Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email + password, for the first administrator of an installation and for
# break-glass access. No sign-up form: the bootstrap account is created on
# first boot (put its email in ADMIN_EMAILS too).
# AUTH_PASSWORD=true
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=

# LLM channel (OpenAI-compatible router)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=

# Secret encryption for MCP / external agent headers (32-byte base64)
AES_ENCRYPTION_KEY=

# Wall-clock cap for a single run, in ms (positive integer; default 600000 = 10 min).
# Bounds every execution path so a hung provider or tool call cannot run unbounded;
# an invalid value is ignored with a warning.
# MAX_RUN_DURATION_MS=600000
# Runs one caller may have in flight at once. A2A has its own ceiling because
# its inbound key is shared, so one identity stands for every machine caller.
# 0 disables a limit.
# MAX_CONCURRENT_RUNS_PER_ACTOR=10
# MAX_CONCURRENT_RUNS_A2A=50

# Trace sampling for non-agent predict runs (0–1). Agent runs are always traced.
TRACE_SAMPLE_RATE=0.1

# OTLP trace export (optional). When the endpoint is set, every persisted trace
# is also exported as OTEL spans (after the database write); unset means no
# export and the OTEL SDK is never loaded. Headers are `key=value,key2=value2`,
# case-preserved — they carry collector credentials.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=

# In-memory TTL for the runtime settings row, in ms (positive; default 5000).
# Cache invalidation on write is process-local, so on a multi-instance
# deployment this bounds how long a demoted admin or a rotated A2A key keeps
# working on instances that did not serve the write.
# SETTINGS_CACHE_TTL_MS=5000

# In-memory TTL for a bound MCP server's tool list, in ms (>= 0; default 60000;
# 0 disables caching). A warm entry also lets the session handshake lazily, so a
# turn that calls no tool makes no MCP request. Registry edits invalidate the
# entry on the instance that served them; this TTL bounds the others.
# MCP_DISCOVERY_CACHE_TTL_MS=60000

# Ceiling on the `ttlMs` a server may ask for on tools/list (SEP-2549), in ms
# (>= 0; default 300000). A server knows its own catalogue, but the same number
# also bounds how long a registry edit goes unseen on the other instances — that
# part belongs to the deployment. 0 ignores server hints entirely and keeps the
# local TTL for everything.
# MCP_MAX_SERVER_TTL_MS=300000

# Restrict sign-in to these email domains (comma-separated). Empty allows all.
ALLOWED_EMAIL_DOMAINS=

# Emails allowed to mutate shared registries: MCP servers, external agents,
# skills (comma-separated). Empty allows any signed-in user.
ADMIN_EMAILS=

# Reverse proxies in front of this deployment (comma-separated IPs/CIDRs, e.g.
# the VPC CIDR when ALB + Istio both append to X-Forwarded-For). Better Auth
# strips these hops to resolve the client IP its rate limiting keys on; empty
# trusts only a single-value header, so behind two proxies every request falls
# into one shared bucket.
# TRUSTED_PROXY_CIDRS=

# Optional per-provider channels. Model ids "provider/model" route to the
# matching LLM_PROVIDER_<PROVIDER>_* channel when registered; anything else
# uses the default LLM_BASE_URL channel with the full model id. Provider
# channels receive the bare model name (prefix stripped) unless
# LLM_PROVIDER_<PROVIDER>_KEEP_MODEL_PREFIX=true.
#
# A channel with no API key is skipped silently — its models then fall through
# to the default channel — unless it authenticates another way (see BEDROCK).
# LLM_PROVIDER_OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_PROVIDER_OPENAI_API_KEY=
# LLM_PROVIDER_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# LLM_PROVIDER_ANTHROPIC_API_KEY=
# LLM_PROVIDER_GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_PROVIDER_GOOGLE_API_KEY=
# LLM_PROVIDER_XAI_BASE_URL=https://api.x.ai/v1
# LLM_PROVIDER_XAI_API_KEY=
#
# A self-hosted serving stack (vLLM, LM Studio, Ollama) on the network — the
# channel an installation without internet runs on. Its models are declared
# on the /models console rather than in the published catalog.
# LLM_PROVIDER_SELFHOSTED_BASE_URL=http://vllm.corp.internal:8000/v1
# LLM_PROVIDER_SELFHOSTED_API_KEY=
#
# Bedrock, through its OpenAI-compatible `bedrock-mantle` endpoint. AUTH=sigv4
# signs every request with the process's AWS credentials, so there is no key to
# set: the pod's identity in the cluster, AWS_PROFILE locally.
#
# The region is in the URL and is read from there, not from AWS_REGION: this
# endpoint does not exist in ap-northeast-2. us-east-1 serves the most models;
# ap-northeast-1 is closer and carries fewer.
#
# Claude is NOT reachable this way — Bedrock serves it on the Anthropic Messages
# API, and this endpoint answers "does not support the '/v1/chat/completions'
# API" for every anthropic.* model. The registry's bedrock/* entries are the
# open-weight models only.
# LLM_PROVIDER_BEDROCK_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
# LLM_PROVIDER_BEDROCK_AUTH=sigv4
#
# OpenRouter as an explicit route rather than the default channel: an
# openrouter/* model id is a deliberate choice to run that model through the
# router, and its usage row records the cost OpenRouter reports rather than the
# registry's estimate.
# LLM_PROVIDER_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# LLM_PROVIDER_OPENROUTER_API_KEY=

# What to do with a model id the registry cannot price: allow (default) runs it
# and books the usage at $0; refuse rejects the run before it dispatches. Turn
# this on where the usage rows become an invoice.
# UNKNOWN_MODEL_POLICY=allow

# Agent Plugins source repo (optional). Each plugin root holds a plugin.json,
# skills/<name>/SKILL.md, and an mcp.json of streamable-http servers
# (stdio/sse entries are reported and skipped; headers are never imported —
# credentials are set in the console). A sync imports what is missing and
# reports the rest; an existing entry is rewritten only when the caller names
# it for overwrite. A cluster-internal server url needs
# MCP_INTERNAL_HOST_SUFFIXES below. Without a repo, an admin uploads a
# `.tar.gz` of the checkout on /plugins instead — the same sync, offline.
PLUGINS_REPO=
PLUGINS_REPO_BRANCH=main

# Read access to the repo above, and the API it lives behind — GitHub.com by
# default, a GitHub Enterprise server when set.
GITHUB_TOKEN=
# GITHUB_API_URL=https://github.example.com/api/v3

# What a Slack reply carries while it is still being written; the final edit
# drops it. Default is a built-in emoji, because a custom name a workspace has
# not defined renders as its own literal text.
# SLACK_LOADING_INDICATOR=:hourglass_flowing_sand:

# A2A (optional). Shared key for inbound A2A JSON-RPC calls (X-A2A-Key header).
# The surface is off only when this is unset AND no named client key has been
# issued (/settings → Client keys). Agent Card URLs use PUBLIC_BASE_URL.
A2A_API_KEY=

# Public base URL for outward-facing URLs (e.g. A2A Agent Card, proxied artifact
# links). Unset falls back to BETTER_AUTH_URL, then the request origin.
PUBLIC_BASE_URL=

# DNS suffixes whose hosts an MCP entry may use even though they resolve to a
# private address — Kubernetes Service names, typically
# <namespace>.svc.cluster.local, or an internal zone. Comma-separated; empty
# leaves the SSRF guard unchanged. Matching is anchored on a label boundary,
# single-label suffixes and IP literals are refused, and this is env-only on
# purpose: widening the outbound boundary should take a deploy. See
# docs/SECURITY.md.
# MCP_INTERNAL_HOST_SUFFIXES=agent-mcps.svc.cluster.local

# DNS suffixes whose hosts the FetchUrl builtin may read despite resolving
# privately — an on-premises wiki or internal API. A separate list from the MCP
# one on purpose: a service this app calls is not thereby a page a model may be
# talked into reading. Same matching rules, env-only for the same reason.
# URL_FETCH_INTERNAL_HOST_SUFFIXES=wiki.corp.internal

# Managed MCP (optional). Containers this app starts on its own host through the
# Docker CLI, reached on loopback. Both unset means the feature is off — the
# routes answer 503 rather than half-enable it. The registry is where images
# are pulled from; any registry the host can reach is accepted.
# MANAGED_MCP_RUNTIME=docker
# MANAGED_MCP_REGISTRY=
